---
import SelectField from './SelectField.astro';

interface Props {
  categories: string[];
}
const { categories } = Astro.props;
---
<form class="rounded-xl border border-card-border bg-white p-[18px]" role="search" onsubmit="return false">
  <div class="grid grid-cols-1 gap-3 min-[821px]:grid-cols-[minmax(0,2fr)_repeat(3,minmax(0,1fr))]">
    <div class="flex flex-col gap-1.5">
      <label for="q" class="text-[13px] font-semibold text-navy">Search</label>
      <input
        id="q"
        name="q"
        type="search"
        placeholder="Job title or keyword, e.g. customer service"
        class="h-11 rounded-lg border border-input-border bg-white px-3 text-[15px]"
      />
    </div>
    <SelectField id="cat" name="category" label="Category" options={[{ value: '', label: 'All categories' }, ...categories]} />
    <SelectField
      id="type"
      name="type"
      label="Job type"
      options={[{ value: '', label: 'Any' }, 'Full-time', 'Part-time', 'Contract']}
    />
    <!-- Page-specific last filter: "Open to" on Remote Work, "Area" on Local Jobs. -->
    <slot />
  </div>
</form>
