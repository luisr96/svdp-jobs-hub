---
import SelectField from './SelectField.astro';
import type { CategoryDef, Filters } from '../lib/filters';
import { JOB_TYPES } from '../lib/filters';

interface Props {
  categories: CategoryDef[];
  filters: Filters;
  active: boolean; // any filter changed from its default
}
const { categories, filters, active } = Astro.props;
const action = Astro.url.pathname;
---
<!-- Plain GET form: works without JavaScript, and results are shareable/bookmarkable URLs. -->
<form id="job-filters" method="get" action={action} role="search" aria-label="Filter jobs" class="rounded-xl border border-card-border bg-white p-[18px]">
  <div class="grid grid-cols-1 gap-3 min-[821px]:grid-cols-[minmax(0,2fr)_repeat(3,minmax(0,1fr))]">
    <div class="flex flex-col gap-1.5">
      <label for="q" class="text-[13px] font-semibold text-navy">Search</label>
      <input
        id="q"
        name="q"
        type="search"
        value={filters.q}
        placeholder="Job title or keyword, e.g. customer service"
        class="h-11 rounded-lg border border-input-border bg-white px-3 text-[15px]"
      />
    </div>
    <SelectField
      id="cat"
      name="category"
      label="Category"
      options={[{ value: '', label: 'All categories' }, ...categories]}
      selected={filters.category}
    />
    <SelectField
      id="type"
      name="type"
      label="Job type"
      options={[{ value: '', label: 'Any' }, ...JOB_TYPES]}
      selected={filters.type}
    />
    <!-- Page-specific last filter: e.g. "Open to" on Remote Work. -->
    <slot />
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-4">
    <button
      type="submit"
      class="h-11 cursor-pointer rounded-lg bg-navy px-6 font-semibold text-white hover:bg-navy-dark max-[820px]:w-full"
    >
      Show jobs
    </button>
    <span data-clear-filters>
      {active && <a href={action} data-clear class="inline-flex min-h-11 items-center text-[15px] font-semibold">Clear filters</a>}
    </span>
  </div>
</form>

<script>
  import { wireSaveButtons } from '../scripts/save-buttons';

  // Apply filters as soon as they change: dropdowns right away, the search box after a delay
  const form = document.querySelector<HTMLFormElement>('#job-filters');
  const SEARCH_DELAY_MS = 400;
  let timer: number | undefined;
  let controller: AbortController | undefined;

  async function update() {
    if (!form) return;
    const params = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
    const url = `${form.action}?${params}`;
    controller?.abort();
    controller = new AbortController();
    try {
      const res = await fetch(url, { signal: controller.signal });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const next = new DOMParser().parseFromString(await res.text(), 'text/html');
      for (const sel of ['[data-job-count]', '[data-job-list]', '[data-clear-filters]']) {
        const from = next.querySelector(sel);
        const to = document.querySelector(sel);
        if (from && to) to.innerHTML = from.innerHTML;
      }
      const list = document.querySelector('[data-job-list]');
      if (list) wireSaveButtons(list);
      history.replaceState(null, '', url);
    } catch (err) {
      if ((err as Error).name === 'AbortError') return;
      form.submit(); // fall back to a normal page load
    }
  }

  // "Show jobs" and Enter in the search box applies in place
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(timer);
    update();
  });

  form?.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).id === 'q') return; // handled by the input listener
    clearTimeout(timer);
    update();
  });
  form?.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).id !== 'q') return;
    clearTimeout(timer);
    timer = window.setTimeout(update, SEARCH_DELAY_MS);
  });

  // "Clear filters" resets the fields in place
  document.addEventListener('click', (e) => {
    if (!form || !(e.target as HTMLElement).closest('a[data-clear]')) return;
    e.preventDefault();
    clearTimeout(timer);
    for (const el of Array.from(form.elements)) {
      if (el instanceof HTMLSelectElement) el.selectedIndex = 0;
      else if (el instanceof HTMLInputElement && el.type === 'search') el.value = '';
    }
    form.querySelector<HTMLInputElement>('#q')?.focus(); // the link is about to disappear
    update();
  });
</script>
