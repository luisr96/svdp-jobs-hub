---
import Icon from './Icon.astro';
import type { Job } from '../lib/types';
import { postedAgo } from '../lib/format';

interface Props {
  job: Job;
}
const { job } = Astro.props;
---
<article
  class="rounded-xl border border-card-border bg-white px-[22px] py-5"
  data-posted={job.postedAt}
  data-has-salary={job.salary ? 'true' : 'false'}
>
  <div class="flex items-center gap-5 max-[820px]:flex-col max-[820px]:items-start">
    <div class="flex min-w-0 grow flex-col gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded bg-gold-tint px-2 py-1 text-xs font-bold uppercase tracking-[0.4px] text-navy">{job.source}</span>
        <span class="text-[13px] text-subtle">{postedAgo(job.postedAt)}</span>
      </div>
      <h2 class="m-0 text-xl leading-[1.3] font-bold text-navy">{job.title}</h2>
      <div class="text-[15px] text-ink-2">{job.company}</div>
      <div class="flex flex-wrap gap-4 text-sm text-muted">
        <span>{job.location}</span>
        {job.jobType && <span>{job.jobType}</span>}
        {job.salary && <span class="font-semibold text-pay">{job.salary}</span>}
      </div>
    </div>
    <div class="flex shrink-0 items-center gap-2.5">
      <button
        type="button"
        aria-label={`Save ${job.title}`}
        class="flex size-11 cursor-pointer items-center justify-center rounded-lg border border-input-border bg-white text-navy hover:bg-page"
      >
        <Icon name="bookmark" size={18} />
      </button>
      <a
        href={job.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View job on ${job.source}`}
        class="inline-flex h-11 w-[140px] items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-navy font-semibold text-white no-underline hover:bg-navy-dark hover:text-white"
      >
        View job <Icon name="external" size={16} />
      </a>
    </div>
  </div>
</article>
