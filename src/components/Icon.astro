---
interface Props {
  name: 'home' | 'pin' | 'person' | 'arrow' | 'bookmark' | 'external';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'home' && <><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" /><path d="M9 21v-7h6v7" /></>}
  {name === 'pin' && <><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'person' && <><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></>}
  {name === 'arrow' && <><path d="M4 12h16" /><path d="m14 6 6 6-6 6" /></>}
  {name === 'bookmark' && <path d="M6 3h12v18l-6-4-6 4z" />}
  {name === 'external' && <path d="M7 17 17 7M9 7h8v8" />}
</svg>
