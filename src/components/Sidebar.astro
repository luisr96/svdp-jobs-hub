---
import Icon from './Icon.astro';
import { navItems } from '../lib/nav';

const current = Astro.url.pathname.replace(/(\.html|\/)$/, '');
---
<aside class="flex flex-col gap-7 bg-navy px-5 py-7 text-white min-[821px]:sticky min-[821px]:top-0 min-[821px]:h-screen">
  <div class="flex flex-col gap-1">
    <div class="font-serif text-[22px] font-bold tracking-[0.2px]">Jobs Hub</div>
    <div class="text-[13px] text-gold-light">St. Vincent de Paul Naples</div>
    <div class="text-[13px] text-gold-light">Job Pathway Program</div>
  </div>

  <nav aria-label="Job categories">
    <!-- Phones: one row of icon + short label tabs, so every link is visible without sideways scrolling. -->
    <ul class="m-0 grid list-none grid-cols-5 gap-1 p-0 min-[821px]:flex min-[821px]:flex-col min-[821px]:gap-1.5">
      {navItems.map((item) => {
        const active = current === item.href;
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex h-full min-h-11 items-center rounded-lg no-underline',
                'max-[820px]:flex-col max-[820px]:justify-center max-[820px]:gap-1 max-[820px]:px-1 max-[820px]:py-2 max-[820px]:text-center max-[820px]:text-xs max-[820px]:leading-tight',
                'min-[821px]:gap-3 min-[821px]:px-3.5 min-[821px]:py-3',
                active ? 'bg-gold font-bold text-navy hover:text-navy' : 'text-white hover:bg-white/10 hover:text-white',
              ]}
            >
              <Icon name={item.icon} />
              <!-- Only one is displayed at a time, so the link's accessible name always matches what's on screen. -->
              <span class="max-[820px]:hidden">{item.label}</span>
              <span class="min-[821px]:hidden">{item.shortLabel}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="mt-auto flex flex-col gap-2 rounded-[10px] border border-navy-line p-4 max-[820px]:hidden">
    <div class="text-sm font-bold">Need help applying?</div>
    <p class="m-0 text-[13px] leading-normal text-side-text">Bring a listing to your Job Pathway coach for resume and interview help.</p>
    <a
      href="https://www.svdpnaples.org/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center text-[13px] font-semibold text-gold-light hover:text-white"
    >
      Contact the program<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</aside>
