---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  intro: string;
}
const { title, intro } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Jobs Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Public+Sans:wght@400;500;600;700&display=swap" />
  </head>
  <body class="m-0">
    <div class="grid min-h-screen grid-cols-1 min-[821px]:grid-cols-[280px_minmax(0,1fr)]">
      <Sidebar />
      <main class="mx-auto flex w-full max-w-[1040px] flex-col gap-6 px-4 py-5 min-[821px]:px-11 min-[821px]:py-9">
        <header class="flex flex-col gap-2">
          <h1 class="m-0 font-serif text-4xl font-bold text-navy">{title}</h1>
          <p class="m-0 max-w-[640px] text-base leading-[1.55] text-muted">{intro}</p>
        </header>
        <slot />
      </main>
    </div>
    <!-- Save confirmations (see scripts/save-buttons.ts). Always present so screen readers announce changes. -->
    <div
      id="status"
      role="status"
      class="pointer-events-none fixed inset-x-4 bottom-4 z-10 mx-auto max-w-md rounded-lg bg-navy px-4 py-3 text-center text-[15px] font-semibold text-white opacity-0 shadow-lg transition-opacity data-show:opacity-100"
    >
    </div>
  </body>
</html>
