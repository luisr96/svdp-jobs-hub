---
import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import JobCard from '../components/JobCard.astro';
import { getRemoteJobs } from '../lib/jobs';

const { jobs, sources } = await getRemoteJobs();
const sourceList = new Intl.ListFormat('en', { type: 'conjunction' }).format(sources);
---
<Layout
  title="Remote Work"
  intro="Work-from-home jobs from trusted remote boards. Click any job to read the full posting and apply on the original site."
>
  <FilterBar />

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="text-sm text-muted" aria-live="polite">
      <strong class="text-navy">{jobs.length} {jobs.length === 1 ? 'job' : 'jobs'}</strong>
      {sources.length > 0 && <> from {sourceList}</>} · updated hourly
    </div>
    <label class="flex items-center gap-2 text-sm text-muted">
      Sort
      <select name="sort" class="h-11 rounded-lg border border-input-border bg-white px-2">
        <option value="newest">Newest first</option>
        <option value="salary">Salary listed</option>
      </select>
    </label>
  </div>

  <div class="flex flex-col gap-3.5">
    {jobs.length > 0 ? (
      jobs.map((job) => <JobCard job={job} />)
    ) : (
      <p class="m-0 rounded-xl border border-card-border bg-white p-6 text-muted">
        We couldn't load remote jobs right now. Please check back in a little while.
      </p>
    )}
  </div>

  <footer class="border-t border-card-border pt-4 text-[13px] leading-[1.6] text-subtle">
    Listings come from <a href="https://weworkremotely.com/">We Work Remotely</a>,
    <a href="https://remotive.com/">Remotive</a> and <a href="https://jobicy.com/">Jobicy</a> and link to the original
    posting. Remotive jobs appear 24 hours after posting. Never pay to apply for a job — if a listing asks for money,
    report it to your coach.
  </footer>
</Layout>
