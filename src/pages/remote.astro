---
import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import JobResults from '../components/JobResults.astro';
import SelectField from '../components/SelectField.astro';
import { getRemoteJobs } from '../lib/jobs';
import { REMOTE_CATEGORIES, applyFilters, hasActiveFilters, parseFilters } from '../lib/filters';
import { setJobPageCacheHeaders } from '../lib/cache-headers';

export const prerender = false; // rendered on request so filters work

const filters = parseFilters(Astro.url.searchParams, REMOTE_CATEGORIES);
const active = hasActiveFilters(filters);
const { jobs, sources } = await getRemoteJobs();
const shown = applyFilters(jobs, filters, { categories: REMOTE_CATEGORIES });
setJobPageCacheHeaders(Astro.response.headers);
---
<Layout
  title="Remote Work"
  intro="Work-from-home jobs from trusted remote boards. Click any job to read the full posting and apply on the original site."
>
  <FilterBar categories={REMOTE_CATEGORIES} filters={filters} active={active}>
    <SelectField
      id="where"
      name="where"
      label="Open to"
      options={[{ value: 'us', label: 'US applicants' }, { value: 'anywhere', label: 'Anywhere' }]}
      selected={filters.where}
    />
  </FilterBar>

  <p class="m-0 rounded-lg border border-card-border bg-white px-4 py-3 text-[15px] leading-normal text-ink">
    <strong>Tip:</strong> Tap the bookmark on any job to save it as you search, then review them all in
    <a href="/saved" class="font-semibold"> Saved Jobs</a> before you leave.
  </p>

  <JobResults
    jobs={shown}
    sources={sources}
    sort={filters.sort}
    active={active}
    loadError="We couldn't load remote jobs right now. Please check back in a little while."
  />

  <footer class="border-t border-card-border pt-4 text-[13px] leading-[1.6] text-subtle">
    Listings come from <a href="https://weworkremotely.com/">We Work Remotely</a>,
    <a href="https://remotive.com/">Remotive</a> and <a href="https://jobicy.com/">Jobicy</a> and link to the original
    posting. Remotive jobs appear 24 hours after posting. Never pay to apply for a job — if a listing asks for money,
    report it to your coach.
  </footer>
</Layout>
