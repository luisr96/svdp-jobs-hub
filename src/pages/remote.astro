---
import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import JobResults from '../components/JobResults.astro';
import SelectField from '../components/SelectField.astro';
import { getRemoteJobs } from '../lib/jobs';

const results = await getRemoteJobs();
---
<Layout
  title="Remote Work"
  intro="Work-from-home jobs from trusted remote boards. Click any job to read the full posting and apply on the original site."
>
  <FilterBar categories={['Customer support', 'Admin & data entry', 'Sales & marketing', 'Tech']}>
    <SelectField
      id="where"
      name="where"
      label="Open to"
      options={[{ value: 'us', label: 'US applicants' }, { value: 'anywhere', label: 'Anywhere' }]}
    />
  </FilterBar>

  <JobResults
    results={results}
    emptyMessage="We couldn't load remote jobs right now. Please check back in a little while."
  />

  <footer class="border-t border-card-border pt-4 text-[13px] leading-[1.6] text-subtle">
    Listings come from <a href="https://weworkremotely.com/">We Work Remotely</a>,
    <a href="https://remotive.com/">Remotive</a> and <a href="https://jobicy.com/">Jobicy</a> and link to the original
    posting. Remotive jobs appear 24 hours after posting. Never pay to apply for a job — if a listing asks for money,
    report it to your coach.
  </footer>
</Layout>
