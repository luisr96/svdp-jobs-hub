---
import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import JobResults from '../components/JobResults.astro';
import SelectField from '../components/SelectField.astro';
import { getLocalJobs } from '../lib/jobs';
import { AREAS } from '../lib/areas';
import { LOCAL_CATEGORIES, applyFilters, hasActiveFilters, parseFilters } from '../lib/filters';
import { setJobPageCacheHeaders } from '../lib/cache-headers';

export const prerender = false; // rendered on request so filters work

const filters = parseFilters(Astro.url.searchParams, LOCAL_CATEGORIES);
const active = hasActiveFilters(filters);
const { jobs, sources } = await getLocalJobs();
const shown = applyFilters(jobs, filters, { categories: LOCAL_CATEGORIES, kind: 'local' });
setJobPageCacheHeaders(Astro.response.headers);
---
<Layout
  title="Local Jobs"
  intro="Jobs in Naples and across Collier County. Click any job to read the full posting and apply on the original site."
>
  <FilterBar categories={LOCAL_CATEGORIES} filters={filters} active={active}>
    <SelectField id="area" name="area" label="Area" options={[...AREAS]} selected={filters.area} />
  </FilterBar>

  <JobResults
    jobs={shown}
    sources={sources}
    sort={filters.sort}
    active={active}
    loadError="We couldn't load local jobs right now. Please check back in a little while."
  />

  <footer class="border-t border-card-border pt-4 text-[13px] leading-[1.6] text-subtle">
    Jobs by <a href="https://www.adzuna.com/">Adzuna</a>. Each listing links to the original posting. Never pay to
    apply for a job — if a listing asks for money, report it to your coach.
  </footer>
</Layout>
