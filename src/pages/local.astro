---
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';

// Adzuna search for Naples, FL (location id 159500).
const ADZUNA_URL = 'https://www.adzuna.com/search?loc=159500';
---
<Layout
  title="Local Jobs"
  intro="Jobs in Naples and across Collier County from Adzuna. We link you straight to its search, where you can read each posting and apply."
>
  <ResourceCard
    name="Adzuna"
    url={ADZUNA_URL}
    buttonLabel="Search jobs on Adzuna"
    whoFor="Anyone looking for work in person in Naples, Immokalee and the rest of Collier County. Adzuna gathers local job postings from many employers and job sites in one place."
    expect={[
      'It is free to search for jobs.',
      'The button opens Adzuna with jobs near Naples already showing.',
      'To change the kind of work, job type, pay or distance, use the "Filter results" panel on the left side of the Adzuna page. On a phone, tap "Filter results" to open it.',
      'Clicking a job opens the original posting, where you apply. Some employers may ask you to create a free account.',
    ]}
    tips={[
      'Try a simple keyword like "cashier", "driver" or "housekeeping".',
      'Real employers never ask you to pay, buy equipment up front, or share bank details before you are hired.',
      'Found a job you like? Bring it to your Job Pathway coach for help with your resume and interview.',
    ]}
  />
</Layout>
